# Mercado Pago Configuration
# Para obter seu Access Token:
# 1. Acesse: https://www.mercadopago.com.br/developers/
# 2. Vá em "Suas integrações" > "Criar aplicação"
# 3. Copie o "Access Token" de Produção ou Testes
MERCADOPAGO_ACCESS_TOKEN=your_access_token_here

# URL da aplicação (necessário para redirecionamentos de pagamento)
# Em produção, use a URL do seu domínio
# Ex: https://seu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (já configurado no ambiente Lasy)
# VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY já estão disponíveis
